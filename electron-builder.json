{
  "name": "cnote",
  "productName": "Cnote",
  "version": "0.1.0",
  "description": "An open-source note-taking and content management application",
  "main": "./dist/main.js",
  "author": "Cnote Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/cnote.git"
  },
  "build": {
    "appId": "com.cnote.app",
    "productName": "Cnote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  }
}
