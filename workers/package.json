{
  "name": "cnote-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers for Cnote API",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
