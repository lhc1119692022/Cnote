    "deploy:proxy": "wrangler deploy --config wrangler-proxy.toml",
    "test:contract": "node scripts/verify-content-service.mjs && node scripts/verify-ai-proxy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.95.0"
  },
  "dependencies": {}
}
