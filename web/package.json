{
  "name": "cnote-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "author": "lhc1119692022",
  "license": "MIT",
  "repository": "https://github.com/lhc1119692022/Cnote",
  "scripts": {
    "test:canvas-optimization": "node scripts/verify-frame-task.mjs && node scripts/verify-canvas-optimization.mjs && node scripts/verify-upstream-contract.mjs && node scripts/verify-canvas-navigation.mjs && node scripts/verify-canvas-user-flow.mjs",
    "test:canvas-release": "node scripts/verify-canvas-release.mjs && npm run typecheck && npm run lint && npm run build && npm run build:desktop && npm --prefix ../desktop run build",
    "test:prompt-autosize": "node scripts/verify-prompt-autosize.mjs",
    "test:resource-library": "node scripts/verify-resource-library.mjs",
    "test:generation-batch": "node scripts/verify-generation-batch.mjs",
    "test:ai-streaming": "node scripts/verify-ai-streaming.mjs",
    "test:ai-upstream": "node scripts/verify-ai-upstream-transport.mjs",
    "test:generation-inputs": "node scripts/verify-generation-inputs.mjs",
    "test:schema": "node scripts/verify-schema.mjs",
    "test:prompt-mentions": "node scripts/verify-prompt-mentions.mjs",
    "test:generation-selection": "node scripts/verify-generation-selection.mjs",
    "test:dialog": "node scripts/verify-dialog.mjs",
    "test:rich-text": "node scripts/verify-rich-text.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "tsc && vite build --mode desktop",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:video-api:mock": "node scripts/verify-video-api-mock.mjs",
    "test:media-policy": "node scripts/verify-media-policy.mjs && node scripts/verify-media-upload-cache.mjs && node scripts/verify-media-storage-refresh.mjs && node scripts/verify-media-readiness.mjs",
    "test:video-media": "node scripts/verify-official-media-rules.mjs && node scripts/verify-video-input-validation.mjs",
    "test:video-media:browser": "node scripts/verify-media-browser.mjs",
    "test:video-media:electron": "node scripts/verify-media-runtime.mjs",
    "test:canvas-navigation": "node scripts/verify-canvas-navigation.mjs",
    "test:runtime-persistence": "node scripts/verify-runtime-persistence.mjs",
    "test:capture-materializer": "node scripts/verify-capture-materializer.mjs",
    "test:document-autosave": "node scripts/verify-document-autosave.mjs",
    "test:session-exit": "node scripts/verify-session-exit.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^24.2.0",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.1",
    "mediabunny": "1.58.0",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.1",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
